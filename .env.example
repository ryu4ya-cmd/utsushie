# コピーして .env.local を作ると、ローカルで設定を変えられる（Vercel では「Settings → Environment Variables」に入れる）。
# 何も書かなければ「練習モード」（外部APIを呼ばず、サンプル動画を返す）で動き、お金はかからない。

# ---- スイッチ ----
# live にしたときだけ本番モードになり、Kling 3.0 / Veo 3.1 に動画を頼む（1本ごとにお金がかかる）。
# 未設定や live 以外の値はすべて練習モード。
# UTSUSHIE_MODE=practice

# ---- ログイン・回数制限・動画の保存場所（Supabase 無料プラン）----
# 3つそろえるとログインが必要になり、1人あたり1日の回数に上限が付く（練習モードでも）。本番モードでは必須。
# Supabase の「Project Settings → API Keys」と「Data API」で見られる。NEXT_PUBLIC_ の2つは画面にも埋め込まれる公開の値。
# NEXT_PUBLIC_ の値を変えたら、Vercel で作り直し（Redeploy）が必要。
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...        ← サーバーだけで使う。人に見せない

# 1日あたりの上限（日本時間の0時に戻る）。下書きは「2本で1回」。0 にすると作れなくなる
# UTSUSHIE_DAILY_DRAFTS=3          1人あたりの下書き
# UTSUSHIE_DAILY_FINALS=1          1人あたりの本番
# UTSUSHIE_DAILY_TOTAL_DRAFTS=30   全員の合計の下書き（お金の歯止め）
# UTSUSHIE_DAILY_TOTAL_FINALS=10   全員の合計の本番（お金の歯止め）

# 独自のメール送信（SMTP）をつないで、メールの文面に {{ .Token }} を足したら 1 にする（ログイン画面に数字のコードの入力欄を出す）
# NEXT_PUBLIC_UTSUSHIE_EMAIL_CODE=1

# Supabase 側で Google ログインを有効にしたら 1 にする（ログイン画面に「Google でログイン」を出す）
# NEXT_PUBLIC_UTSUSHIE_GOOGLE_LOGIN=1

# ---- 本番モードで必要なもの ----
# ジョブIDの署名に使う、32文字以上のランダムな文字列（例: openssl rand -base64 48）
# UTSUSHIE_JOB_SECRET=

# Kling 3.0（セリフあり）。https://app.klingai.com/global/dev で発行するアクセスキーとシークレットキー
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=
# KLING_API_BASE=https://api-singapore.klingai.com
# KLING_MODEL=kling-v3

# Veo 3.1（セリフなし）。Google AI Studio で発行する Gemini API キー
# GEMINI_API_KEY=
# VEO_MODEL=veo-3.1-generate-preview
# VEO_DRAFT_MODEL=veo-3.1-fast-generate-preview

# ---- 無料で本物の動画を作る（CogVideoX-Flash）----
# free にすると、本番モードの動画をすべて智谱 BigModel の無料モデル CogVideoX-Flash に頼む（お金もクレジットも使わない）。
# Kling / Gemini の鍵は要らない。数秒の1本で、日本語のセリフの声や口の動きは出ない。動画に AI 生成の印が付く。
# 無料の機能は規約で「非商用・個人の研究や学習」に限られるので、オーナーが自分で試すときだけに使う。
# UTSUSHIE_VIDEO=free
# https://bigmodel.cn で登録（海外の電話番号も可）し、「API Keys」で発行するキー
# ZHIPU_API_KEY=
# ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
# COGVIDEO_MODEL=cogvideox-flash
